// Vampire Castle Adventure.
let mut input=0;
let mut ended=0;
let mut skip_lf=0;
let mut scripted=0;
let mut length=0;
let mut playing=1;
bytes command[81];
bytes octet[1];

fn main(){
    say("Vampire Castle Adventure\r\n");
    startinput();
    say("You are in the Entrance Hall.\r\n");
    while playing{
        say("\r\n> ");
        let mut got=readline();
        if got==0{playing=0;}
    }
    close(input);if status(){exit(1);}
    return 0;
}

fn say(text){
    while load8(text){
        putc(load8(text));
        if status(){exit(1);}
        text=text+1;
    }
    return 0;
}

fn startinput(){
    if argc()>1{say("Use VAMPIRE or VAMPIRE COMMANDS.TXT.\r\n");exit(1);}
    let mut name="CON";
    if argc(){name=arg(1);scripted=1;}
    input=open(name);
    if status(){say("Cannot open commands.\r\n");exit(1);}
    return 0;
}

fn nextbyte(){
    if ended{return 65535;}
    let mut count=read(input,octet,1);
    if status(){say("Cannot read commands.\r\n");close(input);exit(1);}
    if count==0{ended=1;return 65535;}
    if octet[0]==26{ended=1;return 65535;}
    return octet[0];
}

fn readline(){
    length=0;
    let mut bad=0;
    let mut done=0;
    while done==0{
        let mut c=nextbyte();
        if skip_lf{
            skip_lf=0;
            if c==10{c=nextbyte();}
        }
        if c==65535{done=1;}
        else{
            if (c==13)|(c==10){
                if c==13{skip_lf=1;}
                done=1;
            }else{
                if c==9{c=32;}
                if (c<32)|(c>126){bad=1;}
                if length==80{bad=1;}
                else{command[length]=c;length=length+1;}
            }
        }
    }
    command[length]=0;
    if ended&(length==0)&(bad==0){say("End of commands.\r\n");return 0;}
    if bad{say("Use at most 80 printable characters.\r\n");return 2;}
    if scripted{say(command);say("\r\n");}
    return 1;
}
