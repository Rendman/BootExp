// A RILL compiler written with ordinary RILL procedures, words, and byte buffers.
let mut table = 0;
let mut globals = 0;
let mut localcount = 0;
let mut level = 0;
let mut nextlocal = 0;
let mut tok = 0;
let mut value = 0;
let mut ch = 0;
let mut line = 1;
let mut linehi = 0;
let mut input = 0;
let mut output = 0;
let mut inpos = 0;
let mut inlen = 0;
let mut outlen = 0;
let mut total = 0;
let mut totalhi = 0;
let mut labelno = 0;
let mut ended = 0;
let mut own = 0;
let mut backup = 0;
let mut found = 0;
let mut rectype = 0;
let mut recval = 0;
let mut reclevel = 0;
let mut callbuiltin = 0;
let mut exprdepth = 0;
bytes decimal[10];
bytes inbuf[4096];
bytes outbuf[4096];
bytes ident[32];
bytes string[512];

fn main(){printnum(65535);return 0;}

fn print(s) { let mut c = 0; while 1 { c = load8(s); if c == 0 { return 0; } putc(c); s = s+1; } }

fn printnum(n) {
    let mut place = 10000; let mut c = 0;
    while place { c = 48; while n >= place { n = n-place; c = c+1; } putc(c); place = place/10; }
    return 0;
}
