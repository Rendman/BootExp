bytes data[6];
fn main(){
    let mut h=alloc(64);
    if status(){
        return 1;
    }
    blockload(h,10,"ABCDEF",6);
    let mut bad=status();
    blockread(h,10,data,6);
    bad=bad|status();
    let mut i=0;
    while i<6{
        if data[i]!=load8("ABCDEF"+i){
            bad=1;
        }
        i=i+1;
    }
    blockread(h,63,data,2);
    if status()==0{
        bad=1;
    }
    free(h);
    return bad|status();
}
