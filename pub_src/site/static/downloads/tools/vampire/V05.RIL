// Vampire Castle Adventure.
let mut input=0;
let mut ended=0;
let mut skip_lf=0;
let mut scripted=0;
let mut length=0;
let mut words=0;
let mut playing=1;
let mut location=1;
bytes command[81];
bytes octet[1];
bytes verb[4];
bytes noun[4];
bytes names[40];
bytes paths[120];

fn main(){
    say("Vampire Castle Adventure\r\n");
    startinput();
    newgame();describe();
    while playing{
        say("\r\n> ");
        let mut got=readline();
        if got==0{playing=0;}
        if got==1{
            parse();
            if wordis(verb,"QUI"){say("Goodbye.\r\n");playing=0;}
            else{
                if words{
                    act();
                }
            }
        }
    }
    close(input);if status(){exit(1);}
    return 0;
}

fn say(text){
    while load8(text){
        putc(load8(text));
        if status(){exit(1);}
        text=text+1;
    }
    return 0;
}

fn startinput(){
    if argc()>1{say("Use VAMPIRE or VAMPIRE COMMANDS.TXT.\r\n");exit(1);}
    let mut name="CON";
    if argc(){name=arg(1);scripted=1;}
    input=open(name);
    if status(){say("Cannot open commands.\r\n");exit(1);}
    return 0;
}

fn nextbyte(){
    if ended{return 65535;}
    let mut count=read(input,octet,1);
    if status(){say("Cannot read commands.\r\n");close(input);exit(1);}
    if count==0{ended=1;return 65535;}
    if octet[0]==26{ended=1;return 65535;}
    return octet[0];
}

fn readline(){
    length=0;
    let mut bad=0;
    let mut done=0;
    while done==0{
        let mut c=nextbyte();
        if skip_lf{
            skip_lf=0;
            if c==10{c=nextbyte();}
        }
        if c==65535{done=1;}
        else{
            if (c==13)|(c==10){
                if c==13{skip_lf=1;}
                done=1;
            }else{
                if c==9{c=32;}
                if (c<32)|(c>126){bad=1;}
                if length==80{bad=1;}
                else{command[length]=c;length=length+1;}
            }
        }
    }
    command[length]=0;
    if ended&(length==0)&(bad==0){say("End of commands.\r\n");return 0;}
    if bad{say("Use at most 80 printable characters.\r\n");return 2;}
    if scripted{say(command);say("\r\n");}
    return 1;
}

fn parse(){
    let mut i=0;
    while i<3{verb[i]=32;noun[i]=32;i=i+1;}
    verb[3]=0;noun[3]=0;words=0;i=0;
    while i<length{
        if command[i]==32{i=i+1;}
        else{
            let mut dest=noun;
            if words==0{dest=verb;}
            let mut n=0;
            while n<3{store8(dest+n,32);n=n+1;}
            n=0;let mut stop=0;
            while (i<length)&(stop==0){
                if command[i]==32{stop=1;}
                else{
                    let mut c=command[i];
                    if (c>=97)&(c<=122){c=c-32;}
                    if n<3{store8(dest+n,c);}
                    n=n+1;i=i+1;
                }
            }
            words=words+1;
        }
    }
    return 0;
}

fn wordis(p,s){
    return (load8(p)==load8(s))&
        (load8(p+1)==load8(s+1))&(load8(p+2)==load8(s+2));
}

fn act(){
    if wordis(verb,"HEL"){help();return 0;}
    if wordis(verb,"GO ")|wordis(verb,"CLI")|((words==1)&(direction()!=0)){walk();return 0;}
    if wordis(verb,"LOO"){describe();return 0;}
    say("I don't know how to do that.\r\n");
    return 0;
}

fn help(){
    say("Use the first and last words; only three letters count.\r\n");
    say("LOOK, HELP and QUIT\r\n");
    say("GO NORTH or N; also S, E, W, U and D.\r\n");
    return 0;
}

fn room(n,text,north,south,east,west,up,down){
    store16(names+n*2,text);
    let mut p=n*6;
    paths[p]=north;paths[p+1]=south;
    paths[p+2]=east;paths[p+3]=west;
    paths[p+4]=up;paths[p+5]=down;
    return 0;
}

fn world(){
    room(1,"Entrance Hall",0,0,3,2,0,0);
    room(2,"Study",0,0,1,0,0,0);
    room(3,"Library",0,0,4,1,0,0);
    room(4,"Armory",0,0,5,3,0,0);
    room(5,"Tower",0,0,0,4,0,0);
    room(6,"Lower Tower",0,7,0,0,5,0);
    room(7,"Chapel",6,0,0,0,4,0);
    room(8,"Brick Fireplace",0,2,0,0,0,0);
    return 0;
}

fn roomname(n){return load16(names+n*2);}

fn describe(){
    say("\r\nYou are in the ");say(roomname(location));say(".\r\n");
    say("Exits:");
    let mut i=0;
    while i<6{
        if paths[location*6+i]{say(" ");say(dirname(i+1));}
        i=i+1;
    }
    say("\r\n");
    return 0;
}

fn dirname(n){
    if n==1{return "North";}if n==2{return "South";}
    if n==3{return "East";}if n==4{return "West";}
    if n==5{return "Up";}return "Down";
}

fn direction(){
    let mut p=noun;
    if words==1{p=verb;}
    if wordis(p,"NOR")|wordis(p,"N  "){return 1;}
    if wordis(p,"SOU")|wordis(p,"S  "){return 2;}
    if wordis(p,"EAS")|wordis(p,"E  "){return 3;}
    if wordis(p,"WES")|wordis(p,"W  "){return 4;}
    if wordis(p,"UP ")|wordis(p,"U  "){return 5;}
    if wordis(p,"DOW")|wordis(p,"D  "){return 6;}
    return 0;
}

fn walk(){
    let mut d=direction();
    if d{
        let mut next=paths[location*6+d-1];
        if next{location=next;describe();}
        else{say("You cannot go that way.\r\n");}
        return 0;
    }
    say("You cannot go there.\r\n");
    return 0;
}

fn newgame(){
    location=1;playing=1;
    world();
    return 0;
}
