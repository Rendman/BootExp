ECHO OFF
IF "%1"=="" GOTO USAGE
R0 %1.RIL RESULT.IR
IF ERRORLEVEL 1 GOTO FAILED
I0 RESULT.IR RESULT.ASM
IF ERRORLEVEL 1 GOTO FAILED
A0 RESULT.ASM RESULT.COM
IF ERRORLEVEL 1 GOTO FAILED
COPY RESULT.COM %1.COM >NUL
IF ERRORLEVEL 1 GOTO FAILED
ECHO BUILD PASS
GOTO END
:USAGE
ECHO Use VMAKE V01
GOTO END
:FAILED
ECHO BUILD FAIL - DO NOT RUN AN OLDER GAME
:END
