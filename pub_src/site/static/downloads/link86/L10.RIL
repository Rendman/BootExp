// LINK86 construction checkpoint.
let mut input=0;
let mut inopen=0;
let mut output=0;
let mut outopen=0;
let mut own=0;
let mut keep=0;
let mut table=0;
let mut symbols=0;
let mut unit=1;
let mut pass=1;
let mut line=0;
let mut ended=0;
let mut skip=0;
let mut inpos=0;
let mut inlen=0;
let mut length=0;
let mut pos=0;
let mut toklen=0;
let mut pc=0;
let mut base=0;
let mut firstsize=0;
let mut secondsize=0;
let mut outlen=0;
bytes inbuf[1024];
bytes outbuf[1024];
bytes source[121];
bytes token[32];
fn main(){
    unit=0;preflight();
    table=alloc(10240);if status(){fail(6);}
    pass=1;
    while pass<=2{
        pc=0;unit=1;
        while unit<=2{
            base=pc;openunit();records();closein();
            let mut size=pc-base;
            modulecheck(size);
            if pass==1{
                if unit==1{firstsize=size;}else{secondsize=size;}
            }else{
                if unit==1{if size!=firstsize{fail(7);}}
                else{if size!=secondsize{fail(7);}}
            }
            unit=unit+1;
        }
        if pass==1{unit=0;line=0;createout();}
        pass=pass+1;
    }
    unit=0;line=0;let mut i=0;
    while i<symbols{if get16(table,i*40+36)!=1{fail(7);}i=i+1;}
    finishout();free(table);if status(){fail(6);}table=0;
    commit();report();return 0;
}

fn openunit(){
    line=0;ended=0;skip=0;inpos=0;inlen=0;
    if unit==1{input=open("MAIN.OBJ");}
    else{input=open("UTIL.OBJ");}
    if status(){fail(6);}inopen=1;return 0;
}

fn closein(){close(input);if status(){fail(6);}inopen=0;return 0;}

fn nextbyte(){
    if ended{return 65535;}
    if inpos==inlen{
        inlen=read(input,inbuf,1024);if status(){fail(6);}inpos=0;
        if inlen==0{ended=1;return 65535;}
    }
    let mut c=inbuf[inpos];inpos=inpos+1;
    if c==26{ended=1;return 65535;}return c;
}

fn readline(){
    length=0;let mut started=0;
    while 1{
        let mut c=nextbyte();
        if skip{skip=0;if c==10{c=nextbyte();}}
        if c==65535{if length==0{return 0;}else{breakline();return 1;}}
        if started==0{if line==65535{fail(5);}line=line+1;started=1;}
        if c==13{skip=1;breakline();return 1;}
        if c==10{breakline();return 1;}
        if (c<32)&(c!=9){fail(1);}if c>126{fail(1);}
        if length==120{fail(5);}
        source[length]=c;length=length+1;
    }
    return 0;
}

fn breakline(){
    source[length]=0;pos=0;return 0;
}

fn scan(){
    toklen=0;
    while (pos<length)&((source[pos]==32)|(source[pos]==9)){pos=pos+1;}
    while pos<length{
        let mut c=source[pos];
        if (c==32)|(c==9)|(c==59){token[toklen]=0;return toklen;}
        if toklen==31{fail(5);}
        if (c>=97)&(c<=122){c=c-32;}
        token[toklen]=c;toklen=toklen+1;pos=pos+1;
    }
    token[toklen]=0;return toklen;
}

fn same(s){
    let mut i=0;
    while token[i]==load8(s+i){if token[i]==0{return 1;}i=i+1;}
    return 0;
}

fn finish(){if scan(){fail(1);}return 0;}

fn records(){
    let mut header=0;let mut done=0;
    while readline(){
        if scan(){
            if done{fail(1);}
            if header==0{
                if !same("OBJ1"){fail(1);}finish();header=1;
            }else{
                if same("END"){finish();done=1;}
                else{
                    if same("B"){bytesrecord();}else{if same("P"){definition();}else{if same("R"){reference(82);}else{if same("A"){reference(65);}else{fail(1);}}}}
                }
            }
        }
    }
    if (header==0)|(done==0){fail(1);}return 0;
}

fn hexvalue(digits){
    if toklen!=digits{fail(2);}
    let mut i=0;let mut value=0;
    while i<toklen{
        let mut c=token[i];
        if (c>=48)&(c<=57){c=c-48;}
        else{if (c>=65)&(c<=70){c=c-55;}else{fail(2);}}
        value=value*16+c;i=i+1;
    }
    return value;
}

fn bytesrecord(){
    let mut count=0;
    while scan(){
        if count==16{fail(5);}
        let mut value=hexvalue(2);emit(value);count=count+1;
    }
    if count==0{fail(1);}return 0;
}

fn emit(value){
    if pc==61184{fail(5);}pc=pc+1;
    if pass==2{
        outbuf[outlen]=value;outlen=outlen+1;
        if outlen==1024{flush();}
    }
    return 0;
}

fn flush(){
    if outlen{
        let mut count=write(output,outbuf,outlen);
        if status(){fail(6);}if count!=outlen{fail(6);}outlen=0;
    }
    return 0;
}

fn createout(){
    output=create("LINK.TMP");if status(){fail(6);}
    outopen=1;own=1;return 0;
}

fn finishout(){flush();close(output);if status(){fail(6);}outopen=0;return 0;}

fn preflight(){
    if exists("LINK.TMP"){fail(8);}if status(){fail(6);}
    if exists("LINK.BAK"){fail(8);}if status(){fail(6);}return 0;
}

fn commit(){
    let mut backup=exists("RESULT.COM");if status(){fail(6);}
    if backup{rename("RESULT.COM","LINK.BAK");if status(){fail(6);}}
    rename("LINK.TMP","RESULT.COM");
    if status(){
        if backup{rename("LINK.BAK","RESULT.COM");if status(){keep=1;}}
        fail(6);
    }
    own=0;
    if backup{delete("LINK.BAK");if status(){keep=1;fail(6);}}
    return 0;
}

fn validname(){
    if toklen==0{fail(3);}
    let mut i=0;
    while i<toklen{
        let mut c=token[i];
        if (c!=95)&((c<65)|(c>90)){
            if (i==0)|(c<48)|(c>57){fail(3);}
        }
        i=i+1;
    }
    return 0;
}

fn find(){
    let mut n=0;
    while n<symbols{
        let mut i=0;let mut match=1;
        while i<=toklen{
            if get8(table,n*40+i)!=token[i]{match=0;}
            i=i+1;
        }
        if match{return n*40;}n=n+1;
    }
    return 65535;
}

fn definition(){
    scan();validname();let mut p=find();
    if pass==1{
        if p!=65535{fail(3);}if symbols==256{fail(5);}
        p=symbols*40;symbols=symbols+1;
        let mut i=0;while i<40{set8(table,p+i,0);i=i+1;}
        i=0;while i<toklen{set8(table,p+i,token[i]);i=i+1;}
    }else{
        if p==65535{fail(7);}
        if get16(table,p+36){fail(7);}set16(table,p+36,1);
    }
    scan();let mut value=hexvalue(4);finish();
    if pass==1{set16(table,p+32,value);set16(table,p+34,unit);}
    else{if (get16(table,p+32)!=value)|(get16(table,p+34)!=unit){fail(7);}}
    return 0;
}

fn modulecheck(size){
    let mut i=0;
    while i<symbols{
        let mut p=i*40;
        if get16(table,p+34)==unit{if get16(table,p+32)>size{fail(4);}}
        i=i+1;
    }
    return 0;
}

fn reference(kind){
    scan();validname();let mut p=find();finish();let mut value=0;
    if pass==2{
        if p==65535{fail(3);}
        value=256+get16(table,p+32);
        if get16(table,p+34)==2{value=value+firstsize;}
        if kind==82{value=value-(256+pc+2);}
    }
    emit(value&255);emit(value>>8);return 0;
}

fn print(s){
    while load8(s){putc(load8(s));s=s+1;}return 0;
}

fn number(value){
    let mut place=10000;
    while place{
        putc(value/place+48);value=value%place;place=place/10;
    }
    return 0;
}

fn report(){print("OK RESULT.COM ");number(pc);print(" bytes\r\n");return 0;}

fn fail(code){
    if inopen{close(input);inopen=0;}
    if outopen{close(output);outopen=0;}
    if own{if keep==0{delete("LINK.TMP");}}
    if table{free(table);table=0;}
    print("LINK ERROR ");number(unit);putc(32);number(line);
    print(" CODE ");number(code);print("\r\n");exit(1);return 0;
}
