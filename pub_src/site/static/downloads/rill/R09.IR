; DATA
WORD LINE 1
WORD READTOTAL 0
WORD DEST 0
WORD VALUE 0
WORD WORK 0
WORD PLACE 0
WORD STEP 0
WORD COUNT 0
WORD INPUT 0
WORD CH 0
BUFFER INBYTE 1
; FILENAMES
BUFFER NAMEBUF 12
; Driver
LABEL MAIN
CALL SOURCENAME
ADDR NAMEBUF
OPEN
ST INPUT
STATUS
JNZ IOFAIL
CALL NEXT
LABEL DISPLAY
LD CH
JZ DISPLAYDONE
CALL CHAR
CALL NEXT
JMP DISPLAY
LABEL DISPLAYDONE
LD INPUT
CLOSE
STATUS
JNZ IOFAIL
HALT
; CHAR
LABEL CHAR
PUTC
STATUS
JZ CHARDONE
LIT 4
EXIT
LABEL CHARDONE
RET
; DIVIDE
LABEL DIVIDE
ST VALUE
LIT 0
ST COUNT
LABEL DIVLOOP
LD VALUE
PUSH
LD STEP
ULT DIVDONE
LD VALUE
PUSH
LD STEP
SUB
ST VALUE
LD COUNT
PUSH
LIT 1
ADD
ST COUNT
JMP DIVLOOP
LABEL DIVDONE
LD VALUE
RET
; PAIR
LABEL PAIR
ST WORK
PUSH
LIT 255
AND
CALL CHAR
LIT 256
ST STEP
LD WORK
CALL DIVIDE
LD COUNT
JMP CHAR
LABEL NEWLINE
LIT 2573
CALL PAIR
RET
; NUMBER
LABEL NUMBER
ST WORK
LIT 10000
ST PLACE
LABEL NUMPRINT
LD PLACE
ST STEP
LD WORK
CALL DIVIDE
ST WORK
LD COUNT
PUSH
LIT 48
ADD
CALL CHAR
LD STEP
PUSH
LIT 1
EQ NUMDONE
LIT 10
ST STEP
LD PLACE
CALL DIVIDE
LD COUNT
ST PLACE
JMP NUMPRINT
LABEL NUMDONE
RET
; ERROR
LABEL IOFAIL
LIT 1
JMP ERROR
LABEL SYNTAX
LIT 2
JMP ERROR
LABEL NUMFAIL
LIT 3
JMP ERROR
LABEL NAMEFAIL
LIT 4
JMP ERROR
LABEL CAPFAIL
LIT 5
JMP ERROR
LABEL ERROR
ST READTOTAL
LIT 0
ST DEST
LIT 21061
CALL PAIR
LIT 20306
CALL PAIR
LIT 8274
CALL PAIR
LD LINE
CALL NUMBER
LIT 17184
CALL PAIR
LIT 17487
CALL PAIR
LIT 8261
CALL PAIR
LD READTOTAL
CALL NUMBER
CALL NEWLINE
LIT 1
EXIT
; NEXT
LABEL NEXT
LD CH
PUSH
LIT 10
NE NEXTREAD
LD LINE
PUSH
LIT 1
ADD
ST LINE
LABEL NEXTREAD
LD INPUT
PUSH
ADDR INBYTE
PUSH
LIT 1
READ
ST COUNT
STATUS
JNZ IOFAIL
LD COUNT
JZ ATEND
LD READTOTAL
PUSH
LIT 1
ADD
ST READTOTAL
PUSH
LIT 4096
UGT CAPFAIL
LDB INBYTE
ST CH
PUSH
LIT 26
EQ ATEND
LD CH
PUSH
LIT 127
UGE SYNTAX
LD CH
PUSH
LIT 32
UGE NEXTDONE
LD CH
PUSH
LIT 9
EQ NEXTDONE
LD CH
PUSH
LIT 10
EQ NEXTDONE
LD CH
PUSH
LIT 13
EQ NEXTDONE
JMP SYNTAX
LABEL ATEND
LIT 0
ST CH
LABEL NEXTDONE
RET
; NAMETEXT
LABEL NAMEWORD
ST VALUE
LD PLACE
PUSH
LD VALUE
PUT
LD PLACE
PUSH
LIT 2
ADD
ST PLACE
RET
LABEL SOURCENAME
ADDR NAMEBUF
ST PLACE
LIT 20307
CALL NAMEWORD
LIT 21077
CALL NAMEWORD
LIT 17731
CALL NAMEWORD
LIT 21038
CALL NAMEWORD
LIT 19529
CALL NAMEWORD
LIT 0
CALL NAMEWORD
RET
