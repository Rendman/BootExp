; DATA
WORD VALUE 0
WORD STEP 0
WORD COUNT 0
; Driver
LABEL MAIN
LIT 256
ST STEP
LIT 16712
CALL DIVIDE
LD COUNT
CALL CHAR
HALT
; CHAR
LABEL CHAR
PUTC
STATUS
JZ CHARDONE
LIT 4
EXIT
LABEL CHARDONE
RET
; DIVIDE
LABEL DIVIDE
ST VALUE
LIT 0
ST COUNT
LABEL DIVLOOP
LD VALUE
PUSH
LD STEP
ULT DIVDONE
LD VALUE
PUSH
LD STEP
SUB
ST VALUE
LD COUNT
PUSH
LIT 1
ADD
ST COUNT
JMP DIVLOOP
LABEL DIVDONE
LD VALUE
RET
