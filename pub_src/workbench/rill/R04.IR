; RILL compiler construction. Portable IR source.
WORD TABLE 0
WORD LINE 1
WORD LINEHI 0
WORD INPUT 0
WORD OUTPUT 0
WORD OWN 0
WORD BACKUP 0
BUFFER DECIMAL 10
PROC MAIN 0 0
LIT 2
PUSH
INVOKE ERROR 1
LIT 0
RETURN

PROC PRINT 0 1
SETLOCAL 0
LABEL PRINTLOOP
LOCAL 0
FETCHB
JZ PRINTDONE
PUTC
LOCAL 0
PUSH
LIT 1
ADD
SETLOCAL 0
JMP PRINTLOOP
LABEL PRINTDONE
LIT 0
RETURN

PROC PRINTNUM 0 3
SETLOCAL 0
LIT 10000
SETLOCAL 1
LABEL PRINTPLACE
LIT 48
SETLOCAL 2
LABEL PRINTSUB
LOCAL 0
PUSH
LOCAL 1
CULT
JNZ PRINTDIGIT
LOCAL 0
PUSH
LOCAL 1
SUB
SETLOCAL 0
LOCAL 2
PUSH
LIT 1
ADD
SETLOCAL 2
JMP PRINTSUB
LABEL PRINTDIGIT
LOCAL 2
PUTC
LOCAL 1
PUSH
LIT 10
DIV
SETLOCAL 1
JNZ PRINTPLACE
LIT 0
RETURN

LABEL IOFAIL
LIT 1
JMP FAIL
LABEL SYNTAX
LIT 2
JMP FAIL
LABEL NUMBERFAIL
LIT 3
JMP FAIL
LABEL NAMEFAIL
LIT 4
JMP FAIL
LABEL CAPFAIL
LIT 5
LABEL FAIL
PUSH
INVOKE ERROR 1
LIT 1
EXIT
PROC ERROR 1 0
LD INPUT
JZ ERROROUT
CLOSE
LABEL ERROROUT
LD OUTPUT
JZ ERRORTEMP
CLOSE
LABEL ERRORTEMP
LD BACKUP
JZ ERRORDELETE
LITS "RILL.BAK"
PUSH
LITS "RESULT.IR"
RENAME
STATUS
JNZ ERRORREPORT
LABEL ERRORDELETE
LD OWN
JZ ERRORREPORT
LITS "RILL.TMP"
DELETE
LABEL ERRORREPORT
LD TABLE
JZ ERRORDISPLAY
FREEBLOCK
LABEL ERRORDISPLAY
LITS "ERROR "
CALL PRINT
LD LINEHI
PUSH
LD LINE
PUSH
INVOKE PRINT32 2
LITS " CODE "
CALL PRINT
PARAM 0
CALL PRINTNUM
LITS "\r\n"
CALL PRINT
LIT 1
EXIT

PROC PRINT32 2 8
PARAM 0
SETLOCAL 0
PARAM 1
SETLOCAL 1
LIT 0
SETLOCAL 2
LABEL DECIMALPLACE
LOCAL 0
PUSH
LIT 10
DIV
SETLOCAL 3
LOCAL 0
PUSH
LIT 10
MOD
SETLOCAL 4
LIT 0
SETLOCAL 5
LIT 32768
SETLOCAL 6
LABEL DECIMALBIT
LOCAL 4
PUSH
LIT 2
MUL
SETLOCAL 4
LOCAL 1
PUSH
LOCAL 6
AND
JZ DECIMALNOONE
LOCAL 4
PUSH
LIT 1
ADD
SETLOCAL 4
LABEL DECIMALNOONE
LOCAL 5
PUSH
LIT 2
MUL
SETLOCAL 5
LOCAL 4
PUSH
LIT 10
CULT
JNZ DECIMALNOSUB
LOCAL 4
PUSH
LIT 10
SUB
SETLOCAL 4
LOCAL 5
PUSH
LIT 1
ADD
SETLOCAL 5
LABEL DECIMALNOSUB
LOCAL 6
PUSH
LIT 1
SHR
SETLOCAL 6
JNZ DECIMALBIT
ADDR DECIMAL
PUSH
LOCAL 2
ADD
PUSH
LOCAL 4
PUSH
LIT 48
ADD
PUTB
LOCAL 3
SETLOCAL 0
LOCAL 5
SETLOCAL 1
LOCAL 2
PUSH
LIT 1
ADD
SETLOCAL 2
PUSH
LIT 10
CULT
JNZ DECIMALPLACE
LABEL DECIMALSHOW
LOCAL 2
JZ DECIMALDONE
PUSH
LIT 1
SUB
SETLOCAL 2
ADDR DECIMAL
PUSH
LOCAL 2
ADD
FETCHB
PUTC
JMP DECIMALSHOW
LABEL DECIMALDONE
LIT 0
RETURN
