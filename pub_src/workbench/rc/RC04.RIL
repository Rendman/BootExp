// A RILL compiler written with ordinary RILL procedures, words, and byte buffers.
let mut table = 0;
let mut globals = 0;
let mut localcount = 0;
let mut level = 0;
let mut nextlocal = 0;
let mut tok = 0;
let mut value = 0;
let mut ch = 0;
let mut line = 1;
let mut linehi = 0;
let mut input = 0;
let mut output = 0;
let mut inpos = 0;
let mut inlen = 0;
let mut outlen = 0;
let mut total = 0;
let mut totalhi = 0;
let mut labelno = 0;
let mut ended = 0;
let mut own = 0;
let mut backup = 0;
let mut found = 0;
let mut rectype = 0;
let mut recval = 0;
let mut reclevel = 0;
let mut callbuiltin = 0;
let mut exprdepth = 0;
bytes decimal[10];
bytes inbuf[4096];
bytes outbuf[4096];
bytes ident[32];
bytes string[512];

fn main(){print("READY");return 0;}

fn print(s) { let mut c = 0; while 1 { c = load8(s); if c == 0 { return 0; } putc(c); s = s+1; } }

fn printnum(n) {
    let mut place = 10000; let mut c = 0;
    while place { c = 48; while n >= place { n = n-place; c = c+1; } putc(c); place = place/10; }
    return 0;
}

fn fail(code) {
    if input { close(input); }
    if output { close(output); }
    let mut recovery = 0;
    if backup { rename("RILL.BAK","RESULT.IR"); if status() { recovery = 1; } }
    if recovery == 0 { if own { delete("RILL.TMP"); if status() { recovery=1; } } }
    if table { free(table); table = 0; }
    print("ERROR "); print32(linehi,line); print(" CODE "); printnum(code); print("\r\n");
    if recovery { print("Recovery: inspect RILL.TMP and RILL.BAK\r\n"); } exit(1); return 0;
}

// Divide a pair of words by ten without requiring a wider machine value.

fn print32(hi,lo) {
    let mut i = 0; let mut qhi = 0; let mut rem = 0;
    let mut qlo = 0; let mut bit = 0;
    while i < 10 {
        qhi = hi/10; rem = hi%10; qlo = 0; bit = 32768;
        while bit {
            rem = rem*2; if lo & bit { rem = rem+1; }
            qlo = qlo*2;
            if rem >= 10 { rem = rem-10; qlo = qlo+1; }
            bit = bit>>1;
        }
        decimal[i] = rem+48; hi = qhi; lo = qlo; i = i+1;
    }
    while i { i = i-1; putc(decimal[i]); } return 0;
}
