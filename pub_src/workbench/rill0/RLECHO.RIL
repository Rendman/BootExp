fn main() {
    let mut c = 0;
    let mut s = 0;
    c = getc();
    s = status();
    while s == 0 {
        if c == 65535 {
            exit(0);
        }
        putc(c);
        s = status();
        if s != 0 {
            exit(1);
        }
        c = getc();
        s = status();
    }
    exit(1);
}
