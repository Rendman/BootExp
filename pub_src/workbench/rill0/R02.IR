; RILL compiler construction. Portable IR source.

PROC MAIN 0 0
LIT 65535
CALL PRINTNUM
LIT 0
RETURN

PROC PRINT 0 1
SETLOCAL 0
LABEL PRINTLOOP
LOCAL 0
FETCHB
JZ PRINTDONE
PUTC
LOCAL 0
PUSH
LIT 1
ADD
SETLOCAL 0
JMP PRINTLOOP
LABEL PRINTDONE
LIT 0
RETURN

PROC PRINTNUM 0 3
SETLOCAL 0
LIT 10000
SETLOCAL 1
LABEL PRINTPLACE
LIT 48
SETLOCAL 2
LABEL PRINTSUB
LOCAL 0
PUSH
LOCAL 1
CULT
JNZ PRINTDIGIT
LOCAL 0
PUSH
LOCAL 1
SUB
SETLOCAL 0
LOCAL 2
PUSH
LIT 1
ADD
SETLOCAL 2
JMP PRINTSUB
LABEL PRINTDIGIT
LOCAL 2
PUTC
LOCAL 1
PUSH
LIT 10
DIV
SETLOCAL 1
JNZ PRINTPLACE
LIT 0
RETURN
